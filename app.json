{
  "expo": {
    "name": "DayTickles",
    "slug": "daytickles",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "daytickles",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.daytickles.daytickles",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-web-browser",
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DayTickles to use Face ID to unlock the app."
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DayTickles to access your photos so you can pin them to your Pin Board.",
          "cameraPermission": "Allow DayTickles to use your camera to take a photo for your Pin Board."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "585d9409-ca0f-44f7-a369-c34afc45c053"
      }
    }
  }
}
