{
  "expo": {
    "name": "DayTickles",
    "slug": "daytickles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "daytickles",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9CB42"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.daytickles.daytickles",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9CB42"
      },
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-web-browser",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "sounds": ["./assets/sounds/psst.wav"]
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DayTickles to use Face ID to unlock the app."
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DayTickles to access your photos so you can pin them to your Tickle Pics.",
          "cameraPermission": "Allow DayTickles to use your camera to take a photo for your Tickle Pics.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow DayTickles to access your photos so you can pin them to your Tickle Pics.",
          "savePhotosPermission": "Allow DayTickles to save this photo to your device's Photos app.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "585d9409-ca0f-44f7-a369-c34afc45c053"
      }
    }
  }
}
